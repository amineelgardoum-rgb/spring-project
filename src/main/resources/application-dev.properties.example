# Development profile — copy to application-dev.properties and fill your credentials
spring.datasource.url=jdbc:mariadb://127.0.0.1:3306/annotationbase
spring.datasource.username=YOUR_USER
spring.datasource.password=YOUR_PASSWORD

# Debug logging
logging.level.com.ensah.nlp_annotation_platform=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG


